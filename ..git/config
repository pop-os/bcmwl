[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = gitosis@git.undebian.org:debian/broadcom-sta.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "debian"]
	remote = origin
	merge = refs/heads/debian
[branch "pristine-tar"]
	remote = origin
	merge = refs/heads/pristine-tar
[branch "upstream"]
	remote = origin
	merge = refs/heads/upstream
[branch "debian-lenny-backports"]
	remote = origin
	merge = refs/heads/debian-lenny-backports
